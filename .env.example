# Copy to .env (install.bat does this once). Never commit .env or paste real keys anywhere.
# On a cloud host (e.g. Replit) set the same names as Secrets instead.

# --- Local server -----------------------------------------------------------
# 127.0.0.1 = only this computer can open the app (recommended)
APP_HOST=127.0.0.1
APP_PORT=8000
# Slide previews use the local PowerPoint (or LibreOffice). off = disable.
# PREVIEW_ENGINE=off

# --- AI that writes the slides (LLM) -------------------------------------------
# modal_ollama (default) = Ollama (qwen3:4b) on a Modal GPU only. Gemini is never tried, so no time is lost
#                  waiting for Gemini retries, and the GPU is pre-warmed while Whisper transcribes.
# auto = Gemini first when GEMINI_API_KEY is set; Ollama on Modal when there is no key or Gemini is unavailable
#        (bad key, quota, outage, timeout, invalid output). A Gemini safety refusal is never bypassed.
# gemini = Gemini only | ollama = Ollama on THIS computer (explicit only) | offline = no AI, basic outline
LLM_PROVIDER=modal_ollama

# Gemini (https://aistudio.google.com/apikey). The key stays on this backend (header only, never logged).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Tried when the main Gemini model is overloaded (HTTP 503), inside the same attempt budget
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest
# Request attempts (1-2), seconds per request, total seconds for all attempts of one deck
GEMINI_MAX_ATTEMPTS=2
GEMINI_REQUEST_TIMEOUT_SECONDS=120
GEMINI_TOTAL_BUDGET_SECONDS=300
# A Retry-After longer than this means "fall back now" instead of waiting
GEMINI_MAX_RETRY_AFTER_SECONDS=20
# Repairs of an invalid JSON answer (0-2) before switching the deck to Ollama on Modal
LLM_MAX_REPAIR_ATTEMPTS=2
# Circuit breaker: skip Gemini for COOLDOWN seconds after THRESHOLD consecutive failures (any job).
# Invalid key / exhausted quota / unknown model open it at once. A new key or model re-evaluates it.
LLM_CIRCUIT_FAILURE_THRESHOLD=2
LLM_CIRCUIT_COOLDOWN_SECONDS=600
# Videos at least this long: Gemini also writes in validated stages (part summaries -> outline -> slide
# batches); a Gemini failure moves only the remaining stages to Ollama on Modal.
LLM_STAGED_MIN_SECONDS=900
# Context window used by that staged route (both models); 8192 measured, 16384 possible after measuring
LLM_LONG_NUM_CTX=8192

# Ollama on Modal (worker: infrastructure/modal_llm_worker.py; setup: docs/MODAL_CLOUD_SETUP_VI.md).
# URL printed by `modal deploy infrastructure/modal_llm_worker.py` for the "api" function.
# Calls use the same MODAL_PROXY_TOKEN_* as the image worker (see the AI illustrations section).
MODAL_LLM_WORKER_URL=
MODAL_LLM_APP_NAME=video2slides-llm-worker
MODAL_LLM_MODEL=qwen3:4b
# Informational: GPU type, max containers (1) and scale-down window (60 s) are set in the worker file at deploy time
MODAL_LLM_GPU=L4
# One chat request including a cold start (container start + model load)
MODAL_LLM_REQUEST_TIMEOUT_SECONDS=600
MODAL_POLL_INTERVAL_SECONDS=1.5
# List price used for cost ESTIMATES only (USD per GPU second; check `modal billing rates`)
MODAL_GPU_PRICE_PER_SEC=0.000222

# Ollama request settings (used for Ollama on Modal and local Ollama). The app maps them to Ollama's
# /api/chat fields: options.num_ctx, options.temperature, keep_alive, think. Ollama does not read these names.
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.2
# How long Ollama keeps the model loaded INSIDE a running container/process. On Modal the GPU container
# itself scales to zero after its scale-down window (60 s) regardless of this value.
OLLAMA_KEEP_ALIVE=5m
# Qwen3 "thinking": auto/off = disabled (JSON only), on = enabled. Sent only when the model reports the capability.
OLLAMA_THINK=auto
# Slides written per request (1-6) and repair attempts after an invalid answer (0-2)
OLLAMA_SLIDES_PER_BATCH=3
OLLAMA_MAX_REPAIRS=2

# Local Ollama (only with LLM_PROVIDER=ollama; ~2.5 GB download: `ollama pull qwen3:4b`)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_REQUEST_TIMEOUT_SECONDS=600
RELEASE_WHISPER_BEFORE_LLM=true
AI_MAX_ATTEMPTS=3

# --- Video processing: on Modal (default when configured) or on this computer ----
# auto = Modal when MODAL_MEDIA_WORKER_URL is set, otherwise local | modal | local
# Modal: FFmpeg on a CPU container (audio extraction + frames) and faster-whisper on an L4 GPU (float16).
# No local FFmpeg / Whisper needed. Worker: infrastructure/modal_media_worker.py
MEDIA_PROCESSING=auto
MODAL_MEDIA_WORKER_URL=
MODAL_MEDIA_UPLOAD_CHUNK_MB=4
MODAL_MEDIA_TIMEOUT_SECONDS=2400
# Whisper on the GPU (measured on L4, Vietnamese lecture clip, syllable error rate):
#   base 22.1% | small 13.5% | small + batch 16 + beam 5 + word timestamps 12.6% and 2-3x faster
MODAL_WHISPER_MODEL=small
# English videos (LibriSpeech WER clean/other, L4): small 1.94/5.27% | large-v3-turbo 1.33/3.34%, 90 min of audio in
# 63 s (default) | large-v3 1.25/2.74%, 118 s (most accurate, ~2x slower). Downloaded once into the Modal cache.
MODAL_WHISPER_MODEL_EN=large-v3-turbo
# float16 (default). int8_float16 only after checking transcription quality.
MODAL_WHISPER_COMPUTE_TYPE=float16
MODAL_WHISPER_BEAM_SIZE=5
# 0 = sequential; >0 = batched decoding (sentence segments rebuilt from word timestamps)
MODAL_WHISPER_BATCH_SIZE=16
# Upload only the audio track (copied locally with PyAV, no re-encoding, no FFmpeg install) + a few frames.
# Measured: 13.7 MB video -> 0.76 MB audio in 0.05 s. false = upload the whole MP4.
MODAL_UPLOAD_AUDIO_ONLY=true

# --- Speech recognition (faster-whisper) ---------------------------------
# Model for LOCAL (CPU) processing: tiny | base | small (Modal uses MODAL_WHISPER_MODEL)
# WHISPER_COMPUTE_TYPE / WHISPER_CPU_THREADS apply to local CPU processing only
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=2
WHISPER_BEAM_SIZE=1
# vi | en | auto
DEFAULT_LANGUAGE=vi
# Loudness-normalise audio before transcription (helps quiet recordings)
AUDIO_NORMALIZE=true

# --- Limits ---------------------------------------------------------------
# Videos up to 120 minutes. The file stays on this computer; with cloud processing only its audio track (~60 MB
# for 120 min) is uploaded to Modal.
MAX_UPLOAD_MB=6144
MAX_DURATION_SEC=7200
# Refuse an upload that would leave less free disk space than this
MIN_FREE_DISK_MB=2048
MAX_FRAMES=8
FRAME_WIDTH=1280
FFMPEG_TIMEOUT_SEC=900
MAX_QUEUE_SIZE=3
# Failed/cancelled jobs are deleted after this; finished ones too when KEEP_FINISHED_PRESENTATIONS=false
JOB_TTL_HOURS=24

# --- Storage --------------------------------------------------------------
# DATA_DIR=./data
# MODEL_CACHE_DIR=./.cache/models

# --- Access control -------------------------------------------------------
# When set, the web UI asks for this shared password before any API call.
APP_PASSWORD=

# --- Video URL import (YouTube / Facebook) -----------------------------------
URL_IMPORT_ENABLED=true
# ytdlp = download the link with yt-dlp (installed with the app). Only for content you own or may
# process: platform terms may not allow downloading. off = metadata only, upload the MP4 instead.
# Facebook also supports graph_api (only videos FACEBOOK_ACCESS_TOKEN may read, e.g. your Page).
FACEBOOK_RETRIEVAL=ytdlp
FACEBOOK_ACCESS_TOKEN=
YOUTUBE_RETRIEVAL=ytdlp
YOUTUBE_API_KEY=
URL_MAX_DURATION_SEC=7200
URL_MAX_DOWNLOAD_MB=1536

# --- Slides and reading notes ------------------------------------------------
# Slides always use the full 16:9 canvas (no explanation panel on the slide); both values are accepted.
# The detailed explanation always goes into the speaker notes and the in-app Reading Mode.
DEFAULT_LAYOUT_MODE=presentation
# true = finished presentations stay in the library ("Bài đã tạo"); source videos are always deleted
KEEP_FINISHED_PRESENTATIONS=true

# --- Google Slides output (optional; setup: docs/GOOGLE_SLIDES_SETUP_VI.md) -----
GOOGLE_SLIDES_ENABLED=true
# OAuth client of type "Desktop app" downloaded from Google Cloud Console (never commit it)
# GOOGLE_OAUTH_CLIENT_FILE=./data/google/client_secret.json

# --- Admin API (/api/admin/images/*: usage report, kill switch) ---------------
# Long random string. Empty = admin API disabled.
ADMIN_TOKEN=

# --- AI illustrations (self-hosted SDXL on Modal) ------------------------------
# Feature flag: false = the app behaves exactly as before (no GPU calls at all).
AI_IMAGES_ENABLED=false
# modal_sdxl (real GPU worker) | mock (local placeholder images, development only)
IMAGE_PROVIDER=modal_sdxl
# URL printed by `modal deploy infrastructure/modal_image_worker.py` for the "api" function
MODAL_IMAGE_WORKER_URL=
# Modal *proxy auth* token (Modal dashboard > Settings > Proxy Auth Tokens). Not the deploy token.
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
# true = immediately stop starting new GPU work (also switchable via the admin API)
IMAGE_KILL_SWITCH=false
# fail = the job fails if an illustration cannot be produced; skip = deck without it + visible notice
IMAGE_ON_FAILURE=fail

# Limits (application-level; ALSO set a budget / spend limit in the Modal dashboard)
IMAGE_MAX_PER_PRESENTATION=8
IMAGE_DAILY_LIMIT=40
IMAGE_MONTHLY_LIMIT=300
IMAGE_MONTHLY_BUDGET_USD=5
IMAGE_MAX_REGENERATIONS_PER_JOB=10

# Cost model for pre-batch estimates (Modal L4 list price per second; check modal.com/pricing)
IMAGE_GPU_PRICE_PER_SEC=0.000222
IMAGE_EST_SECONDS_PER_IMAGE=15
IMAGE_EST_BATCH_OVERHEAD_SEC=210

# Generation parameters (validated: <= ~1 MP, 10-40 steps)
IMAGE_WIDTH=1344
IMAGE_HEIGHT=768
IMAGE_STEPS=25
IMAGE_GUIDANCE=6.0
IMAGE_BATCH_TIMEOUT_SEC=900
IMAGE_HTTP_TIMEOUT_SEC=30
IMAGE_POLL_INTERVAL_SEC=3
IMAGE_MAX_ATTEMPTS=2
IMAGE_CACHE_TTL_HOURS=168
